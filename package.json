{
  "name": "expense-tracker",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "BE",
    "FE"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w expense-tracker-be\" \"npm run dev -w expense-tracker-fe\"",
    "dev:be": "npm run dev -w expense-tracker-be",
    "dev:fe": "npm run dev -w expense-tracker-fe",
    "build": "npm run build -w expense-tracker-fe",
    "lint": "npm run lint -w expense-tracker-fe",
    "start:be": "npm run start -w expense-tracker-be"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
